#version 450

// Clustered light-binning compute kernel. One invocation per froxel cluster:
// builds the cluster's world-space AABB from its screen tile + exponential
// depth slice, tests every local light's bounding sphere against it, and writes
// the surviving light indices into the per-cluster list the forward pass reads.
//
// Layouts must match render_types.rs: ClusterParams (128 B) and GpuLight (64 B).
// CLUSTER_LIGHT_LIST_STRIDE mirrors MAX_LIGHTS_PER_CLUSTER + 1. Mirrors
// light_cull.metal / light_cull.hlsl.

layout(local_size_x = 64) in;

const uint CLUSTER_LIGHT_LIST_STRIDE = 64u;
const uint MAX_LIGHTS_PER_CLUSTER = 63u;

// The scalar after each vec3 keeps the std430 layout at the 64-byte packed
// stride (vec3 is 16-aligned in std430).
struct GpuLight {
    vec3  position;
    float range;
    vec3  color;
    float intensity;
    vec3  direction;
    uint  kind;
    float cos_inner;
    float cos_outer;
    int   shadow_index;
    float _pad;
};

layout(std140, set = 0, binding = 0) uniform ClusterBlock {
    mat4  inv_view_proj;
    vec3  cam_pos;
    float z_near;
    vec3  view_forward;
    float z_far;
    uint  grid_x;
    uint  grid_y;
    uint  grid_z;
    uint  num_lights;
    float screen_w;
    float screen_h;
    uint  use_clusters;
    uint  _pad;
} cluster;

layout(std430, set = 0, binding = 1) readonly buffer LocalLightBlock {
    GpuLight local_lights[];
} light_buf;

layout(std430, set = 0, binding = 2) writeonly buffer ClusterListBlock {
    uint cluster_list[];
} list_buf;

// Direction of the camera ray through a screen-NDC point. Unprojects the far
// plane (z = 1) to world space, then normalises from the camera: for a
// perspective projection every ray through a screen point passes through the
// eye, so the far-plane unprojection gives the direction.
vec3 cluster_corner_ray(vec2 ndc) {
    vec4 world = cluster.inv_view_proj * vec4(ndc, 1.0, 1.0);
    world /= world.w;
    return normalize(world.xyz - cluster.cam_pos);
}

void main() {
    uint cid = gl_GlobalInvocationID.x;
    uint cluster_count = cluster.grid_x * cluster.grid_y * cluster.grid_z;
    if (cid >= cluster_count) {
        return;
    }

    uint cx = cid % cluster.grid_x;
    uint cy = (cid / cluster.grid_x) % cluster.grid_y;
    uint cz = cid / (cluster.grid_x * cluster.grid_y);

    // Screen-tile NDC bounds (y flipped: screen y-down to NDC y-up, matching
    // the froxel_to_world unprojection in fog_froxel.comp).
    vec2 lo = vec2(float(cx), float(cy)) / vec2(float(cluster.grid_x), float(cluster.grid_y));
    vec2 hi = vec2(float(cx + 1u), float(cy + 1u))
            / vec2(float(cluster.grid_x), float(cluster.grid_y));
    vec2 ndcs[4] = vec2[4](
        vec2(lo.x * 2.0 - 1.0, -(lo.y * 2.0 - 1.0)),
        vec2(hi.x * 2.0 - 1.0, -(lo.y * 2.0 - 1.0)),
        vec2(lo.x * 2.0 - 1.0, -(hi.y * 2.0 - 1.0)),
        vec2(hi.x * 2.0 - 1.0, -(hi.y * 2.0 - 1.0))
    );

    // Exponential depth slice: near/far view-space distances for this Z band.
    float ratio  = cluster.z_far / cluster.z_near;
    float near_d = cluster.z_near * pow(ratio, float(cz) / float(cluster.grid_z));
    float far_d  = cluster.z_near * pow(ratio, float(cz + 1u) / float(cluster.grid_z));

    // World-space AABB over the tile frustum clamped to [near_d, far_d].
    vec3 aabb_min = vec3(1e30);
    vec3 aabb_max = vec3(-1e30);
    for (uint i = 0u; i < 4u; ++i) {
        vec3  ray = cluster_corner_ray(ndcs[i]);
        float fdot = max(dot(ray, cluster.view_forward), 1e-4);
        vec3  p_near = cluster.cam_pos + ray * (near_d / fdot);
        vec3  p_far  = cluster.cam_pos + ray * (far_d / fdot);
        aabb_min = min(aabb_min, min(p_near, p_far));
        aabb_max = max(aabb_max, max(p_near, p_far));
    }

    uint base  = cid * CLUSTER_LIGHT_LIST_STRIDE;
    uint count = 0u;
    for (uint li = 0u; li < cluster.num_lights; ++li) {
        vec3  lp = light_buf.local_lights[li].position;
        float r  = light_buf.local_lights[li].range;
        // Sphere vs AABB: distance from the light centre to the clamped point.
        vec3 d = lp - clamp(lp, aabb_min, aabb_max);
        if (dot(d, d) <= r * r) {
            if (count < MAX_LIGHTS_PER_CLUSTER) {
                list_buf.cluster_list[base + 1u + count] = li;
                count += 1u;
            }
        }
    }
    list_buf.cluster_list[base] = count;
}
